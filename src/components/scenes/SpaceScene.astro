---
// Space systems: a starfield, the limb of a planet, a dashed orbit, and a
// satellite with foil-wrapped bus and solar arrays drifting along it.
import { rng } from '../../lib/art';

const rand = rng(88);
const stars = Array.from({ length: 150 }, () => ({
  x: Math.round(rand() * 1600),
  y: Math.round(rand() * 720),
  r: (0.6 + rand() * 1.6).toFixed(2),
  tw: rand() > 0.8,
  d: (rand() * 4).toFixed(2),
}));
const cells = Array.from({ length: 12 }, (_, i) => i);
---

<svg class="scene" viewBox="0 0 1600 720" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
  <defs>
    <radialGradient id="planet" cx="0.35" cy="0.3" r="0.8">
      <stop offset="0" stop-color="#3d5f86" />
      <stop offset="0.7" stop-color="#1b2a45" />
      <stop offset="1" stop-color="var(--scene-deep)" />
    </radialGradient>
    <linearGradient id="foil" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#f4dba2" />
      <stop offset="0.5" stop-color="#c8913a" />
      <stop offset="1" stop-color="#f0c46e" />
    </linearGradient>
  </defs>

  {
    stars.map((s) => (
      <circle cx={s.x} cy={s.y} r={s.r} fill="var(--silk)" fill-opacity="0.7" class:list={{ tw: s.tw }} style={`animation-delay:-${s.d}s`} />
    ))
  }

  <circle cx="1480" cy="1160" r="620" fill="url(#planet)" />
  <circle cx="1480" cy="1160" r="624" fill="none" stroke="#7fb2e6" stroke-opacity="0.35" stroke-width="6" />
  <ellipse cx="1180" cy="420" rx="520" ry="150" fill="none" stroke="var(--accent)" stroke-opacity="0.25" stroke-dasharray="3 12" transform="rotate(-14 1180 420)" />

  <g class="sat">
    <g transform="translate(1180 250) rotate(-14)">
      <!-- arrays -->
      {
        [-1, 1].map((side) => (
          <g transform={`translate(${side * 150} 0)`}>
            <path d={`M${side * -48} 0 H${side * -10}`} stroke="var(--silk)" stroke-opacity="0.6" stroke-width="3" />
            <rect x="-90" y="-30" width="180" height="60" fill="#1d3558" stroke="#7fb2e6" stroke-opacity="0.7" stroke-width="2" />
            {cells.map((c) => (
              <rect x={-86 + (c % 6) * 29.3} y={c < 6 ? -26 : 2} width="26" height="24" fill="#2b4f80" />
            ))}
          </g>
        ))
      }
      <!-- bus -->
      <rect x="-42" y="-40" width="84" height="80" rx="4" fill="url(#foil)" />
      <path d="M-42 -12 H42 M-42 14 H42 M-14 -40 V40 M14 -40 V40" stroke="#8a5a1a" stroke-opacity="0.35" />
      <!-- dish and antenna -->
      <path d="M0 -40 V-62" stroke="var(--silk)" stroke-width="3" />
      <path d="M-26 -62 Q0 -86 26 -62 Z" fill="var(--silk)" fill-opacity="0.85" />
      <path d="M0 40 V64 M-10 64 H10" stroke="var(--silk)" stroke-opacity="0.6" stroke-width="3" />
    </g>
  </g>
</svg>

<style>
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .tw {
    animation: twinkle 3.2s ease-in-out infinite;
  }
  @keyframes twinkle {
    50% {
      fill-opacity: 0.1;
    }
  }
  .sat {
    animation: drift 14s ease-in-out infinite;
  }
  @keyframes drift {
    50% {
      transform: translate(-40px, 12px) rotate(-2deg);
    }
  }
</style>
