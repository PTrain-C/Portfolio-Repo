---
// Hydroponics: a nutrient reservoir with slow waves, roots hanging from net
// cups into the water, bubbles from the air pump, and a sensor probe.
import { rng } from '../../lib/art';

const rand = rng(63);
const wave = (y: number, a: number, k: number, phase: number) => {
  let d = `M-40 ${y}`;
  for (let x = -40; x <= 1640; x += 20) d += ` L${x} ${(y + Math.sin(x / k + phase) * a).toFixed(1)}`;
  return d + ' L1640 760 L-40 760 Z';
};
const bubbles = Array.from({ length: 18 }, () => ({
  x: Math.round(820 + rand() * 760),
  r: (3 + rand() * 7).toFixed(1),
  dur: (4 + rand() * 5).toFixed(2),
  delay: (rand() * 6).toFixed(2),
}));
const cups = [980, 1180, 1380];
const root = (x: number, seed: number) => {
  const r = rng(seed);
  return Array.from({ length: 5 }, () => {
    let px = x + (r() - 0.5) * 20;
    let d = `M${px.toFixed(1)} 330`;
    for (let y = 360; y <= 470 + r() * 150; y += 30) {
      px += (r() - 0.5) * 26;
      d += ` L${px.toFixed(1)} ${y}`;
    }
    return d;
  });
};
---

<svg class="scene" viewBox="0 0 1600 720" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
  <path d={wave(380, 10, 90, 0)} fill="var(--accent)" fill-opacity="0.08">
    <animate attributeName="d" dur="7s" repeatCount="indefinite" values={`${wave(380, 10, 90, 0)};${wave(380, 10, 90, 3.14)};${wave(380, 10, 90, 0)}`} />
  </path>
  <path d={wave(400, 7, 60, 1)} fill="var(--accent)" fill-opacity="0.07">
    <animate attributeName="d" dur="5s" repeatCount="indefinite" values={`${wave(400, 7, 60, 1)};${wave(400, 7, 60, 4.14)};${wave(400, 7, 60, 1)}`} />
  </path>

  {
    cups.map((x, i) => (
      <g>
        {root(x, i + 4).map((d) => (
          <path d={d} fill="none" stroke="var(--accent-soft)" stroke-opacity="0.4" stroke-width="2" />
        ))}
        <path d={`M${x - 40} 300 L${x + 40} 300 L${x + 28} 350 L${x - 28} 350 Z`} fill="var(--scene-deep)" stroke="var(--accent)" stroke-opacity="0.6" stroke-width="2" />
        <path d={`M${x - 34} 312 H${x + 34} M${x - 31} 326 H${x + 31} M${x - 29} 340 H${x + 29}`} stroke="var(--accent)" stroke-opacity="0.3" />
        <path d={`M${x} 300 C${x - 10} 250 ${x - 60} 230 ${x - 90} 200 C${x - 40} 200 ${x} 230 ${x} 300`} fill="#6fbf73" fill-opacity="0.8" />
        <path d={`M${x} 300 C${x + 10} 240 ${x + 50} 210 ${x + 96} 190 C${x + 60} 230 ${x + 20} 250 ${x} 300`} fill="#8fd694" fill-opacity="0.85" />
        <path d={`M${x} 300 C${x - 4} 250 ${x + 4} 190 ${x + 6} 150 C${x + 20} 200 ${x + 10} 260 ${x} 300`} fill="#5aa860" fill-opacity="0.9" />
      </g>
    ))
  }

  <g transform="translate(1520 150)">
    <path d="M0 0 V360" stroke="var(--silk)" stroke-opacity="0.5" stroke-width="10" stroke-linecap="round" />
    <circle cy="370" r="12" fill="var(--accent)" />
    <text x="-18" y="-14" class="probe">pH</text>
  </g>

  {
    bubbles.map((b) => (
      <circle
        class="bubble"
        cx={b.x}
        cy="720"
        r={b.r}
        fill="none"
        stroke="var(--accent-soft)"
        stroke-opacity="0.6"
        style={`animation-duration:${b.dur}s;animation-delay:-${b.delay}s`}
      />
    ))
  }
</svg>

<style>
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .probe {
    font-family: var(--mono);
    font-size: 18px;
    fill: var(--silk);
    fill-opacity: 0.7;
  }
  .bubble {
    animation: rise-b linear infinite;
  }
  @keyframes rise-b {
    from {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    to {
      transform: translateY(-320px);
      opacity: 0;
    }
  }
</style>
