---
// Headshot in an arched window with a lamp glow behind it. This is the one
// decorative moment on the site; keep everything around it quiet.
import { site, href } from '../config';
---

<div class="window">
  <div class="glow" aria-hidden="true"></div>
  <div class="frame">
    {
      site.headshot ? (
        <img src={href(`/${site.headshot}`)} alt={`Photo of ${site.name}`} width="400" height="520" />
      ) : (
        <div class="empty" role="img" aria-label="Headshot coming soon">
          <span class="serif">{site.initials}</span>
          <span class="small">Headshot coming soon</span>
        </div>
      )
    }
  </div>
</div>

<style>
  .window {
    position: relative;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5.2;
  }
  .glow {
    position: absolute;
    inset: -18% -22% -10%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--honey) 55%, transparent),
      color-mix(in oklab, var(--honey) 18%, transparent) 55%,
      transparent
    );
    animation: lamp 1.6s ease-out both;
  }
  .frame {
    position: relative;
    height: 100%;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    border: 0.6rem solid var(--pine);
    background: var(--surface);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .empty {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.5rem;
    background: linear-gradient(var(--surface), var(--surface-2));
    color: var(--bark-3);
  }
  .empty .serif {
    font-size: 6rem;
    color: var(--pine);
    opacity: 0.25;
    line-height: 1;
  }
  @keyframes lamp {
    from {
      opacity: 0;
      transform: scale(0.9);
    }
  }
</style>
