---
import { site, href } from '../config';
---

<div class="avatar">
  {
    site.headshot ? (
      <img src={href(`/${site.headshot}`)} alt={`Photo of ${site.name}`} width="320" height="400" />
    ) : (
      <div class="initials" role="img" aria-label="Headshot placeholder">
        <span>{site.initials}</span>
      </div>
    )
  }
  <span class="corner tl" aria-hidden="true"></span>
  <span class="corner br" aria-hidden="true"></span>
</div>

<style>
  .avatar {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0.5rem;
  }
  img,
  .initials {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2);
  }
  .initials {
    display: grid;
    place-items: center;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }
  .initials span {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 125;
    font-weight: 850;
    font-size: clamp(4rem, 10vw, 7rem);
    color: var(--line-strong);
  }
  /* Crop marks */
  .corner {
    position: absolute;
    width: 1rem;
    height: 1rem;
    border-color: var(--accent);
    border-style: solid;
  }
  .tl {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }
  .br {
    bottom: 0;
    right: 0;
    border-width: 0 1px 1px 0;
  }
</style>
