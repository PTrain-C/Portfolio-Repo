---
// The headshot as a large plated pad on the board, with traces routed out of
// it and small pulses of current travelling along a few of them. This is the
// site's one continuous motion.
import { bus } from '../../lib/art';
import { site, href } from '../../config';

const routes = [
  { t: bus([420, 300], [[140, 0], [50, -50], [60, 0]], 3, 16), pulse: [0, 2] },
  { t: bus([300, 420], [[0, 110], [-60, 60], [-260, 0]], 3, 16), pulse: [1] },
  { t: bus([200, 220], [[-90, -90], [0, -80], [-130, 0]], 2, 16), pulse: [0] },
  { t: bus([400, 200], [[70, -70], [0, -90], [140, 0]], 2, 16), pulse: [1] },
  { t: bus([190, 360], [[-120, 0], [-40, 40], [-60, 0]], 2, 16), pulse: [] },
];
---

<div class="pad-wrap">
  <svg class="board" viewBox="0 0 600 600" aria-hidden="true">
    <g class="traces">
      {routes.map((r) => r.t.map((t) => <path d={t.d} />))}
    </g>
    <g class="pulses">
      {
        routes.map((r, i) =>
          r.pulse.map((k, j) => (
            <path d={r.t[k].d} pathLength="1" style={`--delay:${(i * 0.7 + j * 1.3).toFixed(1)}s`} />
          )),
        )
      }
    </g>
    <g class="vias">
      {routes.map((r) => r.t.map((t) => <circle cx={t.end[0]} cy={t.end[1]} r="7" />))}
    </g>
    <circle class="courtyard" cx="300" cy="300" r="196" />
    <circle class="pin1" cx="162" cy="162" r="5" />
    <text class="ref" x="470" y="130">J1</text>
    <circle class="ring" cx="300" cy="300" r="164" />
  </svg>

  <div class="photo">
    {
      site.headshot ? (
        <img src={href(`/${site.headshot}`)} alt={`Photo of ${site.name}`} width="300" height="300" />
      ) : (
        <div class="empty" role="img" aria-label="Headshot coming soon">
          <span class="display">{site.initials}</span>
          <span class="small">Headshot coming soon</span>
        </div>
      )
    }
  </div>
</div>

<style>
  .pad-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .board {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .traces path,
  .pulses path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .traces path {
    stroke: color-mix(in oklab, var(--gold) 70%, var(--mask));
    stroke-width: 5;
  }
  .pulses path {
    stroke: var(--gold-soft);
    stroke-width: 5;
    stroke-dasharray: 0.07 1.3;
    stroke-dashoffset: 0.07;
    filter: drop-shadow(0 0 6px var(--gold));
    animation: flow 3.4s linear infinite;
    animation-delay: var(--delay);
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -1.2;
    }
  }
  .vias circle {
    fill: var(--mask-deep);
    stroke: var(--gold);
    stroke-width: 4;
  }
  .courtyard {
    fill: none;
    stroke: var(--silk-2);
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
    opacity: 0.5;
  }
  .pin1 {
    fill: var(--silk);
    opacity: 0.8;
  }
  .ref {
    font-family: var(--mono);
    font-size: 22px;
    fill: var(--silk);
    opacity: 0.75;
  }
  .ring {
    fill: none;
    stroke: var(--gold);
    stroke-width: 22;
  }
  .photo {
    position: absolute;
    /* Sits just inside the gold ring (r=164, 22 wide, in a 600 box). */
    inset: 25%;
    border-radius: 50%;
    overflow: hidden;
    background: var(--mask-deep);
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .empty {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.25rem;
    color: var(--silk-2);
    background: radial-gradient(circle at 35% 30%, var(--mask-line), var(--mask-deep));
  }
  .empty .display {
    font-size: 6rem;
    color: var(--gold);
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .pulses {
      display: none;
    }
  }
</style>
