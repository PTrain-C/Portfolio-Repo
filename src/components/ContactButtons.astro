---
import { contact } from '../config';

interface Props {
  // 'dark' for use on the board (dark) areas, 'light' for linen areas.
  on?: 'dark' | 'light';
  // Include GitHub (the hero keeps it to Email + LinkedIn).
  github?: boolean;
}
const { on = 'dark', github = true } = Astro.props;

const items = [
  { label: 'Email me', url: contact.email, primary: true },
  { label: 'LinkedIn', url: contact.linkedin },
  ...(github ? [{ label: 'GitHub', url: contact.github }] : []),
];
const primary = on === 'dark' ? 'gold' : 'solid';
const secondary = on === 'dark' ? 'ghost-dark' : '';
---

<div class="row">
  {
    items.map((i) =>
      i.url ? (
        <a class:list={['btn', i.primary ? primary : secondary]} href={i.url}>
          {i.label}
        </a>
      ) : (
        <span
          class:list={['btn', i.primary ? primary : secondary]}
          aria-disabled="true"
          title="Link not added yet (src/config.ts)"
        >
          {i.label}
        </span>
      ),
    )
  }
</div>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
</style>
