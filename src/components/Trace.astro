---
// Decorative scope trace: a sine whose amplitude collapses in one band, like a
// signal through a notch. Drawn once on load, static afterwards.
const W = 1200;
const H = 80;
const mid = H / 2;
const pts: string[] = [];
for (let x = 0; x <= W; x += 3) {
  const t = x / W;
  const notch = 1 - 0.94 * Math.exp(-((t - 0.64) ** 2) / 0.0022);
  const y = mid - 30 * notch * Math.sin(x * 0.055);
  pts.push(`${x},${y.toFixed(1)}`);
}
const d = `M${pts.join(' L')}`;
---

<div class="trace" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
    <line x1="0" y1={mid} x2={W} y2={mid} class="axis"></line>
    <path d={d} pathLength="1"></path>
  </svg>
  <span class="ch label">CH1</span>
</div>

<style>
  .trace {
    position: relative;
    height: clamp(3.5rem, 7vw, 5rem);
    border-block: 1px solid var(--line);
    background:
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 5% 100%;
  }
  svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }
  .axis {
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    vector-effect: non-scaling-stroke;
  }
  path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 2.2s 0.3s var(--ease) forwards;
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--accent) 45%, transparent));
  }
  .ch {
    position: absolute;
    top: 0.4rem;
    left: 0.5rem;
    color: var(--accent);
    font-size: 0.65rem;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
