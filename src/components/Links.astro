---
import { links } from '../config';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<ul class:list={['links', { compact }]}>
  {
    links.map((l) =>
      l.href ? (
        <li>
          <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>
            {l.label}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ) : (
        <li>
          <span class="pending" title="URL not set yet (src/config.ts)">
            {l.label} <em>pending</em>
          </span>
        </li>
      ),
    )
  }
</ul>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .links a {
    text-decoration: none;
  }
  .links a span {
    color: var(--accent);
  }
  .compact {
    font-size: 0.75rem;
  }
  .pending {
    color: var(--ink-3);
  }
  .pending em {
    font-style: normal;
    font-size: 0.85em;
    border: 1px dashed var(--ink-3);
    padding: 0.1em 0.35em;
    margin-left: 0.25em;
  }
</style>
