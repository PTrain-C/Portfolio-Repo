---
// Body of project and experience pages (the PageHero sits above it): long
// form content plus an "at a glance" rail, and links to the previous and next
// entries. `rail` puts the rail on the right, the left, or as a strip on top.
import { href } from '../config';

interface Neighbor {
  label: string;
  path: string;
}
interface Props {
  prev?: Neighbor;
  next?: Neighbor;
  rail?: 'right' | 'left' | 'top';
}
const { prev, next, rail = 'right' } = Astro.props;
---

<div class:list={['wrap', 'body', `rail-${rail}`]}>
  <div class="columns">
    <aside class="side">
      <slot name="side" />
    </aside>
    <div class="main">
      <slot />
    </div>
  </div>
  <slot name="after" />
  {
    (prev || next) && (
      <nav class="pager" aria-label="More">
        {prev ? (
          <a href={href(prev.path)}>
            <span class="small quiet">Previous</span>
            <span class="display">{prev.label}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="right" href={href(next.path)}>
            <span class="small quiet">Next</span>
            <span class="display">{next.label}</span>
          </a>
        )}
      </nav>
    )
  }
</div>

<style>
  .body {
    padding-top: 4rem;
  }
  .columns {
    display: grid;
    gap: 5rem;
    align-items: start;
  }
  .rail-right .columns {
    grid-template-columns: minmax(0, 1fr) 20rem;
  }
  .rail-right .side {
    grid-column: 2;
    grid-row: 1;
    padding-left: 2rem;
    border-left: 2px solid var(--accent);
  }
  .rail-right .main {
    grid-column: 1;
    grid-row: 1;
  }
  .rail-left .columns {
    grid-template-columns: 17rem minmax(0, 1fr);
  }
  .rail-left .side {
    padding-right: 2rem;
    border-right: 2px solid var(--accent);
  }
  .rail-right .side,
  .rail-left .side {
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: 2rem;
  }
  .rail-top .columns {
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
  }
  .rail-top .side {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 2rem 3rem;
    padding: 1.75rem 2rem;
    border-radius: 1.25rem;
    background: var(--linen-2);
    border-top: 3px solid var(--accent);
  }
  .rail-top .main :global(.prose) {
    max-width: 46rem;
  }
  .side :global(h2) {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.7rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.1rem;
    color: var(--bark);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--ink-accent);
  }
  .pager .display {
    font-size: 2.2rem;
  }
  .right {
    text-align: right;
  }
  @media (max-width: 60rem) {
    .rail-right .columns,
    .rail-left .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .rail-right .side,
    .rail-left .side {
      position: static;
      grid-column: auto;
      grid-row: auto;
      border: 0;
      padding: 0;
    }
    .rail-right .main {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
