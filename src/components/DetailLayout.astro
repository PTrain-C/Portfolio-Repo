---
// Shared shell for project and experience detail pages: title block on top,
// long-form content on the left, a sticky "at a glance" panel on the right,
// and links to the previous and next entries.
import { href } from '../config';

interface Neighbor {
  label: string;
  path: string;
}
interface Props {
  backLabel: string;
  backPath: string;
  prev?: Neighbor;
  next?: Neighbor;
}
const { backLabel, backPath, prev, next } = Astro.props;
---

<article class="wrap page">
  <a class="back small" href={href(backPath)}>Back to {backLabel}</a>
  <header>
    <slot name="header" />
  </header>
  <div class="columns">
    <div class="main">
      <slot />
    </div>
    <aside class="side">
      <slot name="side" />
    </aside>
  </div>
  {
    (prev || next) && (
      <nav class="pager" aria-label="More">
        {prev ? (
          <a href={href(prev.path)}>
            <span class="small quiet">Previous</span>
            <span class="serif">{prev.label}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="right" href={href(next.path)}>
            <span class="small quiet">Next</span>
            <span class="serif">{next.label}</span>
          </a>
        )}
      </nav>
    )
  }
</article>

<style>
  .page {
    padding-top: 2rem;
  }
  .back {
    font-weight: 650;
  }
  header {
    margin: 2rem 0 3rem;
    max-width: 48rem;
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 21rem;
    gap: 4.5rem;
    align-items: start;
  }
  .side {
    position: sticky;
    top: 1.5rem;
    display: grid;
    gap: 1.5rem;
    padding: 1.6rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--bark);
  }
  .pager a:hover {
    background: var(--surface);
    color: var(--pine);
  }
  .pager .serif {
    font-size: 1.4rem;
  }
  .right {
    text-align: right;
  }
  @media (max-width: 60rem) {
    .columns {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .side {
      position: static;
      order: -1;
    }
  }
</style>
