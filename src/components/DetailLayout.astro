---
// Body of project and experience pages (the PageHero sits above it): long
// form content on the left, an "at a glance" rail on the right, and links to
// the previous and next entries.
import { href } from '../config';

interface Neighbor {
  label: string;
  path: string;
}
interface Props {
  prev?: Neighbor;
  next?: Neighbor;
}
const { prev, next } = Astro.props;
---

<div class="wrap body">
  <div class="columns">
    <div class="main">
      <slot />
    </div>
    <aside class="side">
      <slot name="side" />
    </aside>
  </div>
  {
    (prev || next) && (
      <nav class="pager" aria-label="More">
        {prev ? (
          <a href={href(prev.path)}>
            <span class="small quiet">Previous</span>
            <span class="display">{prev.label}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="right" href={href(next.path)}>
            <span class="small quiet">Next</span>
            <span class="display">{next.label}</span>
          </a>
        )}
      </nav>
    )
  }
</div>

<style>
  .body {
    padding-top: 4rem;
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 5rem;
    align-items: start;
  }
  .side {
    position: sticky;
    top: 6.5rem;
    display: grid;
    gap: 2rem;
    padding-left: 2rem;
    border-left: 2px solid var(--gold);
  }
  .side :global(h2) {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.7rem;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: grid;
    gap: 0.1rem;
    color: var(--bark);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--pine);
  }
  .pager .display {
    font-size: 2.2rem;
  }
  .right {
    text-align: right;
  }
  @media (max-width: 60rem) {
    .columns {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .side {
      position: static;
      order: -1;
    }
  }
</style>
