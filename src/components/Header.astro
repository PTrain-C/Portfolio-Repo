---
import { site, href } from '../config';

const nav = [
  { label: 'Projects', path: '/projects' },
  { label: 'Experience', path: '/experience' },
  { label: 'Skills', path: '/skills' },
  { label: 'Coursework', path: '/coursework' },
];

const current = Astro.url.pathname.replace(/\/$/, '');
const isActive = (path: string) => {
  const target = href(path);
  return current === target || current.startsWith(`${target}/`);
};
---

<header class="wrap">
  <a class="home serif" href={href('/')}>{site.name}</a>
  <nav aria-label="Main">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={href(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="btn primary talk" href={href('/#contact')}>Get in touch</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }
  .home {
    font-size: 1.6rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--bark);
  }
  .home:hover {
    color: var(--pine);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  ul a {
    display: block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    color: var(--bark-2);
    font-weight: 650;
    text-decoration: none;
  }
  ul a:hover {
    color: var(--pine);
    background: var(--surface-2);
  }
  ul a[aria-current='page'] {
    color: var(--pine);
    background: var(--surface);
    box-shadow: inset 0 0 0 1.5px var(--pine);
  }
  .talk {
    padding: 0.55rem 1.1rem;
  }
  @media (max-width: 52rem) {
    header,
    nav {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .talk {
      display: none;
    }
  }
</style>
