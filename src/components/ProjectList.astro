---
import type { CollectionEntry } from 'astro:content';
import { href } from '../config';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="label">No published projects yet.</p>
  ) : (
    <ol class="list">
      {projects.map((p, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={href(`/projects/${p.id}`)}>
            <span class="idx label">P{String(i + 1).padStart(2, '0')}</span>
            <span class="main">
              <span class="title">
                {p.data.title}
                {p.data.status === 'draft' && <span class="badge">draft</span>}
              </span>
              <span class="summary">{p.data.summary}</span>
            </span>
            <ul class="tags">
              {p.data.tags.slice(0, 3).map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  )
}

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list > li {
    border-bottom: 1px solid var(--line);
  }
  a {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr auto 2rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.6rem 0;
    text-decoration: none;
  }
  a::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease);
  }
  a:hover::before,
  a:focus-visible::before {
    transform: scaleY(1);
  }
  a:hover {
    color: inherit;
  }
  .idx {
    padding-left: 0.75rem;
  }
  .main {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 118;
    font-weight: 750;
    font-size: clamp(1.35rem, 3vw, 2.1rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color 0.2s;
  }
  a:hover .title {
    color: var(--accent);
  }
  .summary {
    color: var(--ink-2);
    font-size: 0.95rem;
    max-width: 40rem;
  }
  .arrow {
    font-family: var(--font-mono);
    color: var(--ink-3);
    transition:
      transform 0.3s var(--ease),
      color 0.2s;
  }
  a:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }
  @media (max-width: 48rem) {
    a {
      grid-template-columns: 3rem 1fr 1.5rem;
    }
    .tags {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
