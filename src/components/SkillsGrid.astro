---
import { skills } from '../data/skills';
---

<dl class="skills">
  {
    skills.map((g, i) => (
      <div class="row" data-reveal style={`--i:${i}`}>
        <dt class="label">{g.group}</dt>
        <dd>
          <ul class="tags">
            {g.items.map((s) => (
              <li class="tag">
                {s.name}
                {s.note && <em> / {s.note}</em>}
              </li>
            ))}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .skills {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) 1fr;
    gap: 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
