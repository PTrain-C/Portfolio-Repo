---
// Photo slot. Without `src` it renders an empty frame so layout can be judged
// before real photos exist. `src` is a path inside /public.
//   frame: 'plain' (rounded) or 'print' (white border, slight tilt)
//   ratio: CSS aspect ratio; 'auto' keeps the image's own shape
import { href } from '../config';

interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  ratio?: string;
  frame?: 'plain' | 'print';
  tilt?: number;
  fit?: 'cover' | 'contain';
}
const { src, alt = '', caption, ratio = '16 / 10', frame = 'plain', tilt = 0, fit = 'cover' } = Astro.props;
---

<figure class:list={[frame]} style={`--ratio:${ratio};--tilt:${tilt}deg;--fit:${fit}`}>
  {
    src ? (
      <img src={href(`/${src}`)} alt={alt} loading="lazy" />
    ) : (
      <div class="empty" role="img" aria-label={`Photo coming soon: ${caption ?? 'image'}`}>
        <span class="small">Photo coming soon</span>
      </div>
    )
  }
  {caption && <figcaption class="small quiet">{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 2.25rem 0;
  }
  img,
  .empty {
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: var(--fit);
    border-radius: 1rem;
    background: var(--scene-deep);
  }
  .print {
    padding: 0.6rem 0.6rem 0.2rem;
    background: #fbf8ef;
    border-radius: 0.3rem;
    box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.45);
    transform: rotate(var(--tilt));
  }
  .print img {
    border-radius: 0.15rem;
  }
  .print figcaption {
    padding: 0.55rem 0.2rem 0.5rem;
  }
  .empty {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--linen-2), color-mix(in oklab, var(--linen-2) 80%, var(--bark-3)));
    color: var(--bark-3);
  }
  figcaption {
    margin-top: 0.6rem;
  }
</style>
