---
// Photo slot. Without `src` it renders an empty, labelled frame so layout can
// be judged before real photos exist.
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}
const { src, alt = '', caption } = Astro.props;
---

<figure>
  {
    src ? (
      <img src={src} alt={alt} loading="lazy" />
    ) : (
      <div class="empty" role="img" aria-label={`Photo placeholder: ${caption ?? 'image'}`}>
        <span>photo pending</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 2.5rem 0;
  }
  img,
  .empty {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--line);
  }
  .empty {
    display: grid;
    place-items: center;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 24px 24px,
      var(--bg-raised);
  }
  .empty span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    background: var(--bg);
    padding: 0.4em 0.7em;
    border: 1px dashed var(--line-strong);
  }
  figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-3);
  }
</style>
