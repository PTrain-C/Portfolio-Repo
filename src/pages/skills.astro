---
import Base from '../layouts/Base.astro';
import { href } from '../config';
import { categories } from '../data/skills';
import { getSkillUsage } from '../lib/content';

const usage = await getSkillUsage();
---

<Base title="Skills" description="Every skill, grouped, with where each one was used.">
  <section class="wrap page">
    <h1>Skills</h1>
    <p class="lede">
      Grouped by area. Each skill links to the roles and projects where I used it.
    </p>

    <nav class="jump" aria-label="Skill areas">
      {
        categories.map((c) => (
          <a class="pill" data-tone={c.tone} href={`#${c.id}`}>
            {c.name}
          </a>
        ))
      }
    </nav>

    <div class="cats">
      {
        categories.map((c) => (
          <section class="cat" id={c.id} data-tone={c.tone}>
            <div class="cat-head">
              <h2>{c.name}</h2>
              <p class="quiet">{c.blurb}</p>
            </div>
            <ul class="rows">
              {c.skills.map((s) => {
                const used = usage.get(s.id) ?? [];
                return (
                  <li id={s.id}>
                    <span class="name">
                      {s.name}
                      {s.note && <span class="quiet small"> ({s.note})</span>}
                    </span>
                    <span class="used">
                      {used.length ? (
                        used.map((u) =>
                          u.path ? (
                            <a href={href(u.path)}>
                              {u.label}
                              <span class="kind">{u.kind}</span>
                            </a>
                          ) : (
                            <span class="plain">
                              {u.label}
                              <span class="kind">{u.kind}</span>
                            </span>
                          ),
                        )
                      ) : (
                        <span class="quiet small">Not linked to a project yet</span>
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: 3rem;
  }
  .lede {
    margin: 1rem 0 2rem;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3.5rem;
  }
  .jump a:hover {
    color: var(--surface);
    background: var(--tone);
  }
  .cats {
    display: grid;
    gap: 2rem;
  }
  .cat {
    display: grid;
    grid-template-columns: 17rem 1fr;
    gap: 2.5rem;
    padding: 2rem 2.25rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border-left: 6px solid var(--tone);
    scroll-margin-top: 1.5rem;
  }
  .cat-head h2 {
    font-size: 1.5rem;
    color: var(--tone);
  }
  .cat-head p {
    margin: 0.5rem 0 0;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows li {
    display: grid;
    grid-template-columns: 15rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.75rem 0.75rem;
    border-bottom: 1px solid var(--line);
    border-radius: var(--radius-sm);
    scroll-margin-top: 6rem;
  }
  .rows li:last-child {
    border-bottom: 0;
  }
  .rows li:target {
    background: color-mix(in oklab, var(--honey) 22%, var(--surface));
    animation: found 1.8s ease-out;
  }
  @keyframes found {
    from {
      background: color-mix(in oklab, var(--honey) 60%, var(--surface));
    }
  }
  .name {
    font-weight: 700;
  }
  .used {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
  }
  .used a,
  .plain {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .plain {
    color: var(--bark-2);
  }
  .used a .kind {
    display: inline-block;
  }
  .kind {
    font-size: 0.78rem;
    color: var(--bark-3);
  }
  @media (max-width: 56rem) {
    .cat,
    .rows li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
