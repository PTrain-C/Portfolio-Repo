---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { getExperience, getCredentials } from '../lib/content';

const experience = await getExperience();
const entries = await Promise.all(
  experience.map(async (e) => ({ e, Content: (await render(e)).Content })),
);
const credentials = await getCredentials();
---

<Base title="Experience" description="Engineering roles and leadership.">
  <section class="wrap page">
    <SectionHead index="01" title="Experience" as="h1" />

    <ol class="roles">
      {
        entries.map(({ e, Content }, i) => (
          <li class="role" data-reveal style={`--i:${i}`}>
            <div class="side">
              {e.data.start ? (
                <p class="label dates">
                  {e.data.start === e.data.end ? e.data.start : `${e.data.start} → ${e.data.end}`}
                </p>
              ) : (
                <p class="badge">dates pending</p>
              )}
              {e.data.location && <p class="label">{e.data.location}</p>}
            </div>
            <div class="body">
              <h2>{e.data.org}</h2>
              <p class="title">
                {e.data.role}
                {e.data.unit && <span class="muted"> / {e.data.unit}</span>}
              </p>
              <div class="prose">
                <Content />
              </div>
              <ul class="tags">
                {e.data.tags.map((t) => (
                  <li class="tag">{t}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    {
      credentials.length > 0 && (
        <div class="creds" data-reveal>
          <p class="label">Credentials</p>
          <ul>
            {credentials.map((c) => (
              <li>
                <span class="c-title">{c.data.title}</span>
                <span class="muted">{c.data.issuer}</span>
                <span class="label">{c.data.date}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</Base>

<style>
  .page {
    padding-top: clamp(3rem, 7vw, 5rem);
  }
  .roles {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr;
    gap: clamp(1rem, 4vw, 3rem);
    padding: 2.5rem 0;
    border-top: 1px solid var(--line);
  }
  .side p {
    margin: 0 0 0.4rem;
  }
  .side .badge {
    display: inline-block;
  }
  .dates {
    color: var(--accent);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.8rem, 4.5vw, 3.2rem);
    font-variation-settings: 'wdth' 120;
    font-weight: 800;
  }
  .title {
    margin: 0.5rem 0 1.25rem;
    font-size: 1.1rem;
  }
  .body .prose :global(p) {
    margin-bottom: 1.25rem;
  }
  .creds {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: var(--bg-raised);
  }
  .creds p {
    margin: 0 0 1rem;
  }
  .creds ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .creds li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: baseline;
  }
  .c-title {
    font-weight: 600;
  }
  @media (max-width: 40rem) {
    .role {
      grid-template-columns: 1fr;
    }
  }
</style>
