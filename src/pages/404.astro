---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { href } from '../config';
---

<Base title="Page not found">
  <PageHero seed={41}>
    <h1>Open circuit.</h1>
    <p class="lede">This page doesn't exist. The link may be old, or the page may have moved.</p>
    <p class="go"><a class="btn gold" href={href('/')}>Go to the home page</a></p>
  </PageHero>
</Base>

<style>
  .go {
    margin-top: 2rem;
  }
</style>
