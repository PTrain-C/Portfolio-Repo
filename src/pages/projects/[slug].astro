---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import SkillPills from '../../components/SkillPills.astro';
import ProjectArt from '../../components/art/ProjectArt.astro';
import { href } from '../../config';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const teamLabel = { solo: 'Solo project', team: 'Team project', unknown: 'Team size to come' }[
  data.team
];
const neighbor = (p?: CollectionEntry<'projects'>) =>
  p && { label: p.data.title, path: `/projects/${p.id}` };
---

<Base title={data.title} description={data.summary}>
  <PageHero back={{ label: 'projects', path: '/projects' }} seed={9}>
    <h1>{data.title}</h1>
    {data.fullName && <p class="full">{data.fullName}</p>}
    <p class="lede">{data.summary}</p>
    <dl class="meta">
      {data.period && (
        <div>
          <dt>When</dt>
          <dd>{data.period}</dd>
        </div>
      )}
      <div>
        <dt>Team</dt>
        <dd>{teamLabel}</dd>
      </div>
      {data.outcome && (
        <div>
          <dt>Where it ended up</dt>
          <dd>{data.outcome}</dd>
        </div>
      )}
    </dl>
    <Fragment slot="aside">
      {data.cover ? <img src={href(`/${data.cover}`)} alt="" /> : <ProjectArt variant={data.art} />}
    </Fragment>
  </PageHero>

  <DetailLayout prev={neighbor(prev)} next={neighbor(next)}>
    <div class="prose">
      <Content />
    </div>

    <Fragment slot="side">
      <div class="mine">
        <h2>My part</h2>
        {data.mine.length ? (
          <ul>
            {data.mine.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        ) : (
          <span class="todo">Still to write</span>
        )}
      </div>

      {data.team !== 'solo' && (
        <div class="others">
          <h2>Teammates' parts</h2>
          {data.others.length ? (
            <ul>
              {data.others.map((o) => (
                <li>
                  {o.part}
                  <span class="small quiet by">{o.by}</span>
                </li>
              ))}
            </ul>
          ) : (
            <span class="todo">Still to write</span>
          )}
        </div>
      )}

      <div>
        <h2>Skills I used</h2>
        {data.skills.length ? <SkillPills ids={data.skills} grouped /> : <span class="todo">Still to write</span>}
      </div>
    </Fragment>
  </DetailLayout>
</Base>

<style>
  .full {
    margin: 0.75rem 0 0;
    color: var(--gold);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2rem 0 0;
  }
  .meta dt {
    font-size: 0.8rem;
    color: var(--silk-2);
  }
  .meta dd {
    margin: 0.1rem 0 0;
    color: var(--silk);
    max-width: 18rem;
  }
  .mine ul,
  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .mine li,
  .others li {
    position: relative;
    padding-left: 1.1rem;
    line-height: 1.4;
  }
  .mine li::before,
  .others li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
  }
  .mine li::before {
    background: var(--pine);
  }
  .others li {
    color: var(--bark-2);
  }
  .others li::before {
    border: 1.5px solid var(--bark-3);
  }
  .by {
    display: block;
  }
</style>
