---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import SkillPills from '../../components/SkillPills.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const teamLabel = { solo: 'Solo project', team: 'Team project', unknown: 'Team size to come' }[
  data.team
];
const neighbor = (p?: CollectionEntry<'projects'>) =>
  p && { label: p.data.title, path: `/projects/${p.id}` };
---

<Base title={data.title} description={data.summary}>
  <DetailLayout backLabel="projects" backPath="/projects" prev={neighbor(prev)} next={neighbor(next)}>
    <Fragment slot="header">
      <h1>{data.title}</h1>
      {data.fullName && <p class="quiet full">{data.fullName}</p>}
      <p class="lede">{data.summary}</p>
    </Fragment>

    <div class="prose">
      <Content />
    </div>

    <Fragment slot="side">
      <div>
        <h2 class="side-h">At a glance</h2>
        <dl class="facts">
          {data.period && (
            <>
              <dt>When</dt>
              <dd>{data.period}</dd>
            </>
          )}
          <dt>Team</dt>
          <dd>{teamLabel}</dd>
          {data.outcome && (
            <>
              <dt>Where it ended up</dt>
              <dd>{data.outcome}</dd>
            </>
          )}
        </dl>
      </div>

      <div class="mine">
        <h2 class="side-h">My part</h2>
        {data.mine.length ? (
          <ul>
            {data.mine.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        ) : (
          <span class="todo">Still to write</span>
        )}
      </div>

      {data.team !== 'solo' && (
        <div class="others">
          <h2 class="side-h">Teammates' parts</h2>
          {data.others.length ? (
            <ul>
              {data.others.map((o) => (
                <li>
                  {o.part}
                  <span class="small quiet by">{o.by}</span>
                </li>
              ))}
            </ul>
          ) : (
            <span class="todo">Still to write</span>
          )}
        </div>
      )}

      <div>
        <h2 class="side-h">Skills I used</h2>
        {data.skills.length ? <SkillPills ids={data.skills} grouped /> : <span class="todo">Still to write</span>}
      </div>
    </Fragment>
  </DetailLayout>
</Base>

<style>
  .full {
    margin: 0.5rem 0 0;
  }
  .lede {
    margin: 1.25rem 0 0;
  }
  .side-h {
    font-size: 1.05rem;
    margin-bottom: 0.75rem;
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }
  .facts dt {
    font-size: 0.85rem;
    color: var(--bark-3);
  }
  .facts dd {
    margin: 0 0 0.6rem;
  }
  .mine ul,
  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .mine li {
    padding-left: 0.85rem;
    border-left: 3px solid var(--pine);
    line-height: 1.35;
  }
  .others li {
    padding-left: 0.85rem;
    border-left: 3px solid var(--line);
    color: var(--bark-2);
    line-height: 1.35;
  }
  .by {
    display: block;
  }
</style>
