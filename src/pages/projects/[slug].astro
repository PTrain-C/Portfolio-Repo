---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import SkillPills from '../../components/SkillPills.astro';
import Sources from '../../components/Sources.astro';
import RelatedCard from '../../components/RelatedCard.astro';
import ProjectArt from '../../components/art/ProjectArt.astro';
import { href } from '../../config';
import { getProjects, getExperience } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const role = data.experience ? (await getExperience()).find((e) => e.id === data.experience) : undefined;
const heroImage = data.heroImage ?? data.cover;
const teamLabel = { solo: 'Solo project', team: 'Team project', unknown: 'Team size to come' }[data.team];
const neighbor = (p?: CollectionEntry<'projects'>) => p && { label: p.data.title, path: `/projects/${p.id}` };
---

<Base title={data.title} description={data.summary} theme={data.theme}>
  <PageHero
    back={{ label: 'projects', path: '/projects' }}
    seed={9}
    theme={data.theme}
    layout={data.hero}
    image={data.hero === 'scene' ? undefined : heroImage}
  >
    {data.fullName && <p class="kicker">{data.fullName}</p>}
    <h1>{data.title}</h1>
    <p class="lede">{data.summary}</p>
    <dl class="meta">
      {
        data.period && (
          <div>
            <dt>When</dt>
            <dd>{data.period}</dd>
          </div>
        )
      }
      <div>
        <dt>Team</dt>
        <dd>{teamLabel}</dd>
      </div>
      {
        data.outcome && (
          <div>
            <dt>Where it ended up</dt>
            <dd>{data.outcome}</dd>
          </div>
        )
      }
    </dl>
    {
      data.links.length > 0 && (
        <p class="links">
          {data.links.map((l) => (
            <a class="btn ghost-dark" href={l.url.startsWith('/') ? href(l.url) : l.url} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))}
        </p>
      )
    }
    {!heroImage && data.hero !== 'scene' && <ProjectArt slot="aside" variant={data.art} />}
  </PageHero>

  <DetailLayout prev={neighbor(prev)} next={neighbor(next)} rail={data.rail}>
    <div class="prose">
      <Content />
    </div>

    <Fragment slot="side">
      <div class="mine">
        <h2>My part</h2>
        {
          data.mine.length ? (
            <ul>
              {data.mine.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          ) : (
            <span class="todo">Still to write</span>
          )
        }
      </div>

      {
        data.team !== 'solo' && (
          <div class="others">
            <h2>Teammates' parts</h2>
            {data.others.length ? (
              <ul>
                {data.others.map((o) => (
                  <li>
                    {o.part}
                    <span class="small quiet by">{o.by}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <span class="todo">Still to write</span>
            )}
          </div>
        )
      }

      <div>
        <h2>Skills I used</h2>
        {data.skills.length ? <SkillPills ids={data.skills} grouped /> : <span class="todo">Still to write</span>}
      </div>

      {
        role && (
          <RelatedCard
            path={`/experience/${role.id}`}
            kicker="Part of my role at"
            title={role.data.org}
            theme={role.data.theme}
          />
        )
      }
    </Fragment>

    <Sources slot="after" items={data.sources} />
  </DetailLayout>
</Base>

<style>
  .kicker {
    margin: 0 0 0.8rem;
    color: var(--accent);
    font-size: 0.95rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2rem 0 0;
  }
  .meta dt {
    font-size: 0.8rem;
    color: var(--silk-2);
  }
  .meta dd {
    margin: 0.1rem 0 0;
    color: var(--silk);
    max-width: 18rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 2rem 0 0;
  }
  .links .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .mine ul,
  .others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .mine li,
  .others li {
    position: relative;
    padding-left: 1.1rem;
    line-height: 1.4;
  }
  .mine li::before,
  .others li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
  }
  .mine li::before {
    background: var(--ink-accent);
  }
  .others li {
    color: var(--bark-2);
  }
  .others li::before {
    border: 1.5px solid var(--bark-3);
  }
  .by {
    display: block;
  }
</style>
