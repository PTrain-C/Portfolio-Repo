---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { coursework } from '../data/coursework';

const hasPlaceholders = coursework.some((g) => g.courses.some((c) => c.placeholder));
---

<Base title="Coursework" description="Relevant coursework at USC.">
  <PageHero seed={31}>
    <h1>Coursework</h1>
    <p class="lede">Classes at USC, grouped by area.</p>
  </PageHero>

  <section class="wrap body">
    {hasPlaceholders && <p class="todo">Course list to come</p>}
    <div class="groups">
      {
        coursework.map((g) => (
          <section class="group">
            <h2 class="display">{g.group}</h2>
            <p class="quiet small">{g.blurb}</p>
            <ul>
              {g.courses.map((c) => (
                <li class:list={{ placeholder: c.placeholder }}>
                  <span class="code">{c.code}</span>
                  <span>{c.name}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .body {
    padding-top: 3rem;
  }
  .groups {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
  }
  .group {
    padding-top: 1rem;
    border-top: 2px solid var(--gold);
  }
  h2 {
    font-size: 1.9rem;
  }
  .group > p {
    margin: 0.4rem 0 1.25rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.5rem;
  }
  .code {
    font-weight: 600;
    color: var(--pine);
  }
  .placeholder,
  .placeholder .code {
    color: var(--bark-3);
  }
  @media (max-width: 60rem) {
    .groups {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
