---
import Base from '../layouts/Base.astro';
import { coursework } from '../data/coursework';

const hasPlaceholders = coursework.some((g) => g.courses.some((c) => c.placeholder));
---

<Base title="Coursework" description="Relevant coursework at USC.">
  <section class="wrap page">
    <h1>Coursework</h1>
    <p class="lede">Classes at USC, grouped by area.</p>
    {hasPlaceholders && <p class="todo">Course list to come</p>}

    <div class="groups">
      {
        coursework.map((g) => (
          <section class="group">
            <h2>{g.group}</h2>
            <p class="quiet small">{g.blurb}</p>
            <ul>
              {g.courses.map((c) => (
                <li class:list={{ placeholder: c.placeholder }}>
                  <span class="code">{c.code}</span>
                  <span>{c.name}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .page {
    padding-top: 3rem;
  }
  .lede {
    margin: 1rem 0 1rem;
  }
  .groups {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  .group {
    padding: 1.75rem 2rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  h2 {
    font-size: 1.45rem;
  }
  .group > p {
    margin: 0.35rem 0 1.25rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.75rem;
  }
  .code {
    font-weight: 700;
    color: var(--pine);
  }
  .placeholder,
  .placeholder .code {
    color: var(--bark-3);
  }
  @media (max-width: 48rem) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
</style>
