---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DetailLayout from '../../components/DetailLayout.astro';
import SkillPills from '../../components/SkillPills.astro';
import { getExperience } from '../../lib/content';

export async function getStaticPaths() {
  const experience = await getExperience();
  return experience.map((e, i) => ({
    params: { slug: e.id },
    props: { entry: e, prev: experience[i - 1], next: experience[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'experience'>;
  prev?: CollectionEntry<'experience'>;
  next?: CollectionEntry<'experience'>;
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const dates = !data.start
  ? null
  : data.start === data.end
    ? data.start
    : `${data.start} to ${data.end}`;
const neighbor = (e?: CollectionEntry<'experience'>) =>
  e && { label: e.data.org, path: `/experience/${e.id}` };
---

<Base title={`${data.role}, ${data.org}`} description={data.summary}>
  <PageHero back={{ label: 'experience', path: '/experience' }} seed={17}>
    {
      data.current && (
        <p class="now">
          <span class="live" aria-hidden="true" /> Current role
        </p>
      )
    }
    <h1>{data.org}</h1>
    <p class="role">
      {data.role}
      {data.unit && <span>, {data.unit}</span>}
    </p>
    <p class="lede">{data.summary}</p>
    <dl class="meta">
      <div>
        <dt>When</dt>
        <dd>{dates ?? 'Dates to come'}</dd>
      </div>
      {data.location && (
        <div>
          <dt>Where</dt>
          <dd>{data.location}</dd>
        </div>
      )}
    </dl>
  </PageHero>

  <DetailLayout prev={neighbor(prev)} next={neighbor(next)}>
    {
      data.highlights.length > 0 && (
        <section class="highlights">
          <h2 class="display">What I did</h2>
          <ul>
            {data.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose">
      <h2>The details</h2>
      <Content />
    </div>

    <Fragment slot="side">
      <div>
        <h2>Skills I used</h2>
        <SkillPills ids={data.skills} grouped />
      </div>
    </Fragment>
  </DetailLayout>
</Base>

<style>
  .now {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    color: var(--gold);
    font-size: 0.9rem;
  }
  .role {
    margin: 0.9rem 0 0;
    font-size: 1.3rem;
    color: var(--silk);
  }
  .role span {
    color: var(--silk-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 2rem 0 0;
  }
  .meta dt {
    font-size: 0.8rem;
    color: var(--silk-2);
  }
  .meta dd {
    margin: 0.1rem 0 0;
    color: var(--silk);
  }
  .highlights {
    margin-bottom: 3rem;
  }
  .highlights h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .highlights ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .highlights li {
    position: relative;
    padding: 0.85rem 0 0.85rem 1.6rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 1.35rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--mask);
    box-shadow: 0 0 0 2px var(--gold);
  }
</style>
